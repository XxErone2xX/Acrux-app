{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acrux",
  "version": "0.1.0",
  "identifier": "com.acrux.next",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Acrux macro - Made by 얼로니", "url": "desktop/index.html", "width": 1392, "height": 903 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 }
  }
}
