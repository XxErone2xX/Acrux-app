{
  "name": "acrux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node frontend/build.mjs",
    "tauri": "tauri",
    "build:macos": "tauri build --target universal-apple-darwin --bundles app --no-sign",
    "init:ios": "tauri ios init --ci",
    "build:ios": "tauri ios build --target aarch64 --ci --no-sign",
    "build:ios:simulator": "tauri ios build --target aarch64-sim --ci --no-sign"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
